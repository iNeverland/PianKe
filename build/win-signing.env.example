# Windows code signing environment variables for release builds.
# Do not commit real certificate files or passwords.
#
# PowerShell:
#   $env:WIN_CSC_LINK="C:\path\to\certificate.pfx"
#   $env:WIN_CSC_KEY_PASSWORD="your-certificate-password"
#   npm run electron:build:win:signed
#
# macOS/Linux shell:
#   export WIN_CSC_LINK="/path/to/certificate.pfx"
#   export WIN_CSC_KEY_PASSWORD="your-certificate-password"
#   npm run electron:build:win:signed
