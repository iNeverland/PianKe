{
  "name": "pianke",
  "version": "2.0.3",
  "type": "module",
  "description": "Personal cinema journal - desktop app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "check": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\" && vite build && electron-builder",
    "electron:build:win": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\" 2>nul & vite build && electron-builder --win nsis",
    "electron:build:win:signed": "vite build && electron-builder --win nsis --config build/win-signed.yml",
    "electron:publish": "npm run build && electron-builder --publish always",
    "electron:publish:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "electron-updater": "^6.8.9",
    "pocketbase": "^0.27.3",
    "sharp": "^0.35.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "uuid": "^11.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^8.0.0",
    "zod": "^3.24.0"
  }
}
