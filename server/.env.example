# PianKe TMDB 代理环境变量模板
# 复制本文件为同目录下的 `.env`，然后填入你的值：
#   cp .env.example .env
# 注意：`.env` 含真实密钥，已被 .gitignore 忽略，不要提交到仓库。

# TMDB 凭据（二选一，服务端自动识别）：
#   - v4 Read Access Token（推荐，eyJ... 开头）
#   - v3 API Key（32 位十六进制）
# 这是唯一必须向 TMDB 申请的凭据，与客户端 appToken 无关。
TMDB_TOKEN=

# 客户端访问口令（x-app-token）。自行生成，无需向任何第三方申请：
#   openssl rand -hex 32     或     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 该值必须与打包时注入客户端的 PIANKE_TMDB_PROXY_TOKEN 一致。
# 留空则代理不鉴权，仅剩限流保护。
APP_TOKEN=

# 轮换过渡期专用：旧口令，逗号分隔可填多个。
# 用途：先在服务器上把新口令写入 APP_TOKEN、把即将废弃的旧口令写到这里，
# 这样尚未升级的客户端不会立刻 401；等客户端全部升级后再删除本行。
# 设置期间启动日志会持续告警。
# APP_TOKEN_PREVIOUS=

# ── 设备凭据（把共享口令降级为「仅注册」）─────────────────────────────────────
# 背景：共享口令随安装包分发，能被提取，因此不适合长期当作访问凭据。
# 开启后客户端会用共享口令换取设备凭据，之后按设备记账、可单独吊销。
# 详见 docs/tmdb-proxy-selfhost.md 的「设备凭据」一节。

# 是否允许注册新设备（默认 true）。设为 false 只影响新注册，不影响已有设备。
# DEVICE_ENROLLMENT=true

# 关键开关：共享口令是否还能直接取数据（默认 true，兼容旧客户端）。
# 客户端全部升级到使用设备凭据后，把它设为 false —— 此后共享口令即使继续泄露，
# 也只能用于「注册」，能造成的损失被下面的注册配额限死。
# LEGACY_TOKEN_DATA_ACCESS=true

# 设备库与注册配额
# MAX_DEVICES=200
# REGISTER_LIMIT_PER_HOUR=10
# REGISTER_LIMIT_PER_DAY=100

# 设备库目录。systemd 会通过 StateDirectory 注入 /var/lib/pianke-tmdb，
# 通常不需要手工设置；直接 node 运行时才需要。
# STATE_DIRECTORY=/var/lib/pianke-tmdb

# 可选：监听端口（默认 8787）
# PORT=8787

# 可选：监听地址（默认 127.0.0.1，切勿在无反代的情况下设为 0.0.0.0）
# HOST=127.0.0.1

# 可选：仅在可信反向代理之后才设为 true，否则攻击者可伪造 X-Forwarded-For 绕过限流
# TRUST_PROXY=false
